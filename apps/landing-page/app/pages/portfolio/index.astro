---
const linkedinUrl = 'https://www.linkedin.com/in/wiame-akli/';
const confidentiality = "Note de confidentialité : Les données chiffrées et visuels présentés sont partiellement anonymisés dans le respect des projets d'ETYO et d'Atelier Carré d'Arche. Mon parcours rassemble d'autres opérations denses : je serai ravie d'en détailler la méthodologie et les livrables lors d'un entretien.";
const panels = [
  { id: 'aps', label: 'APS', kicker: '01 / AMONT', title: 'Avant-Projet Sommaire', quote: "Intervenir dès les premières réflexions d'un projet, c'est comprendre les besoins, les usages et les contraintes avant de définir une réponse technique.", metrics: ['62 512 m² analysés', 'Programmation multi-usages', 'Séquencement stratégique'], environments: 'SÉCURITÉ / INSTITUTIONNEL · INDUSTRIE / R&D · RESTAURATION COLLECTIVE · TERTIAIRE · PATRIMOINE', tasks: 'Analyse des besoins, faisabilité, analyse urbaine & réglementaire (PLUi, ICPE, OAP), programmation fonctionnelle (AutoCAD, Excel).', studies: ['CRS 27 Toulouse — 62 512 m²', 'M2I Lacq', 'RU Théorème'], value: 'Capacité à structurer les besoins amont en données directement exploitables.' },
  { id: 'apd', label: 'APD', kicker: '02 / CONCEPTION', title: 'Avant-Projet Définitif', quote: "Concevoir, c'est transformer des besoins et des contraintes en une réponse technique cohérente, adaptée aux usages et à la réglementation.", metrics: ['2 100 m² réhabilitation lourde', 'Modélisation BIM 3D · ArchiCAD', 'Normes PMR & Incendie'], environments: 'SANTÉ · PATRIMOINE · LOGEMENT · TERTIAIRE · ÉQUIPEMENTS PUBLICS', tasks: 'Analyse de plans, modélisation ArchiCAD, vérification PMR & Sécurité incendie (ERP 5e cat, Logements 2e famille).', studies: ['Maison des Compagnons du Devoir Bourges — 2 100 m²', 'Maison de Santé Pluridisciplinaire'], value: 'Lien fluide entre conception architecturale et chiffrage technique.' },
  { id: 'cctp', label: 'CCTP', kicker: '03 / PRESCRIPTION', title: 'Cahier des Clauses Techniques Particulières', quote: "Un CCTP n'est pas une simple description de travaux. Il doit intégrer usages, contraintes, interfaces et phasage pour être réellement exploitable.", metrics: ['Site industriel exploité', 'Découpage 4 lots structurés', 'Prescriptions sur-mesure'], environments: 'INDUSTRIE · RÉHABILITATION · TERTIAIRE · ÉQUIPEMENTS PUBLICS', tasks: 'Décomposition par lots, description des ouvrages, choix constructifs, contraintes de phasage en site occupé.', studies: ['Usine Nexans Mehun-sur-Yèvre', 'Quai de chargement · SAS · VRD · Charpente métallique · Bardage · Électricité'], value: 'Production de CCTP opérationnels et réalistes.' },
  { id: 'dpgf', label: 'DPGF', kicker: '04 / ÉCONOMIE', title: 'Décomposition du Prix Global et Forfaitaire', quote: "Un prix n'a de sens que s'il est replacé dans le contexte technique de l'opération : surfaces, ouvrages, choix constructifs et contraintes.", metrics: ['Chiffrage à tolérance < 5 %', 'Aménagement · 38 logements', 'Ratios vs détail · Excel'], environments: 'SANTÉ · LOGEMENT · PATRIMOINE · TERTIAIRE · RÉHABILITATION', tasks: 'Métrés APD, quantification des ouvrages, recherche de prix unitaires, calculs d’écarts.', studies: ['IFSI/IFAS Vierzon — contraintes ABF & sécurité incendie', 'Projet Les Ormeaux Saint-Maur — 6 M€'], value: 'Lecture technique du chiffrage reliant chaque montant à sa réalité constructive.' },
  { id: 'act', label: 'ACT', kicker: '05 / CONSULTATION', title: 'Assistance Contrats de Travaux', quote: "Une offre ne se résume jamais à son montant. Il faut confronter les prix aux quantités, aux plans, au CCTP et à la méthodologie pour comprendre réellement la réponse de l'entreprise.", metrics: ['Analyse multi-lots', 'Consultation · 6+ expertises', 'Rédaction de RAO'], environments: 'ÉQUIPEMENTS PUBLICS · RÉHABILITATION · INDUSTRIE · LOGISTIQUE', tasks: 'Contrôle des DPGF candidats, questionnaires d’alignement, comparatifs technico-financiers (Prix 40 % / Valeur technique 60 %).', studies: ['Hospice Colbert Châteauneuf-sur-Cher', 'Plateforme logistique Montbartier — 88 000 m²'], value: 'Analyse approfondie de la réponse réelle des entreprises.' },
  { id: 'opc', label: 'OPC', kicker: '06 / PILOTAGE', title: 'Ordonnancement, Pilotage, Coordination', quote: "Une bonne planification intègre les interdépendances entre corps d'état et anticipe les interfaces susceptibles de ralentir l'opération.", metrics: ['Séquencement sous contraintes', 'Coordination multi-lots', 'Suivi OPR & réserves'], environments: 'RÉHABILITATION · TERTIAIRE · LOGEMENT · ÉQUIPEMENTS PUBLICS', tasks: 'Plannings GanttProject, gestion des interdépendances, suivi de chantier, levée des réserves.', studies: ['Bâtiment B3 Vierzon — cloisons / menuiseries / peinture', 'Suivi de chantier et conformité PMR'], value: 'Anticipation des interfaces et fluidification du chantier.' },
  { id: 'audit', label: 'AUDIT', kicker: '07 / DÉCISION', title: 'Due Diligence & Stratégie', quote: "Chaque bâtiment possède ses propres usages, contraintes et points de vigilance. L'audit consiste à confronter l'analyse documentaire aux observations de terrain, à hiérarchiser les risques et à en mesurer les conséquences techniques et financières.", metrics: ['Horizon 10–15 ans · CAPEX / OPEX', 'Due Diligence transactionnelle', 'Diagnostic technique complet'], environments: 'LOGISTIQUE · TERTIAIRE · COMMERCE · INDUSTRIE', tasks: 'Audit Data Room, inspection terrain, analyse de passages caméra (VRD/CVC), chiffrage paramétrique CAPEX (41 700 € HT), rapports Red Flag, reliance letters en anglais.', studies: ['Actif commercial Le Pian-Médoc — SOFIDY', 'Résidence Tripode A Toulouse', 'Portefeuille logistique Ventoux'], value: "Diagnostic structuré éclairant directement la décision d'investissement." },
];
const software = ['AutoCAD', 'ArchiCAD', 'Revit', 'Robot Structural', 'GanttProject', 'Solibri', 'EveBIM', 'Pack Office'];
---
<!doctype html>
<html lang="fr">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#F2EFE9" /><title>Wiame Akli — Assistante cheffe de projet</title><meta name="description" content="Portfolio de Wiame Akli, assistante cheffe de projet en ingénierie technique et stratégie immobilière." /></head>
  <body>
    <div class="portfolio">
      <header class="header"><a class="brand" href="#profile">WIAME AKLI <span>Assistante cheffe de projet</span></a><nav class="nav" aria-label="Navigation du portfolio" role="tablist">{panels.map((panel) => <button class="tab" id={`tab-${panel.id}`} type="button" role="tab" aria-controls={`panel-${panel.id}`} aria-selected={panel.id === 'aps'} data-tab={panel.id}>{panel.label}</button>)}<button class="tab" id="tab-profile" type="button" role="tab" aria-controls="profile" aria-selected="false" data-tab="profile">CV</button><a class="tab external" href={linkedinUrl} target="_blank" rel="noreferrer">LINKEDIN ↗</a></nav></header>
      <main class="main">
        <section class="hero"><div class="hero-copy"><p class="eyebrow">ARCHITECTURE · CONSTRUCTION · PILOTAGE</p><h1>Construire<br /><strong>avec précision.</strong></h1><p class="intro">Rigoureuse, impliquée et orientée résultats, je contribue à la conception et à la réalisation d’ouvrages durables, optimisés et conformes aux standards techniques actuels.</p><a class="hero-cta" href="#profile" data-profile>DÉCOUVRIR LE PROFIL <span aria-hidden="true">↗</span></a><p class="hero-meta">PERMIS B · DISPONIBLE POUR UN NOUVEAU PROJET</p></div><div class="hero-media" aria-label="Composition visuelle chantier et modélisation 3D"><img src="/portfolio/page-de-garde.jpg" alt="Composition visuelle d'un projet de construction" /><div class="hero-media-grid" aria-hidden="true"></div><div class="hero-media-caption">CHANTIER / MODÉLISATION 3D</div></div></section>
        {panels.map((panel, index) => <section class="panel" id={`panel-${panel.id}`} role="tabpanel" aria-labelledby={`tab-${panel.id}`} hidden={index !== 0} data-panel={panel.id}><div class="heading"><span>{panel.kicker}</span><h2>{panel.title}</h2></div><p class="quote">“{panel.quote}”</p><p class="note">{confidentiality}</p><div class="grid"><div class="cell"><label>Repères chiffrés</label><div class="metrics">{panel.metrics.map((metric) => <strong>{metric}</strong>)}</div></div><div class="cell wide"><label>Environnements</label><p>{panel.environments}</p></div><div class="cell wide"><label>Compétences</label><p>{panel.tasks}</p></div><div class="cell"><label>Expériences représentatives</label><ul>{panel.studies.map((study) => <li>{study}</li>)}</ul></div><div class="cell wide"><label>Ce que je peux apporter</label><p class="value">{panel.value}</p></div></div><div class="footer"><p>Une opération gagne en fluidité quand chaque interface est comprise et documentée.</p><div><a class="cta" href={linkedinUrl} target="_blank" rel="noreferrer">Discuter de ces opérations en entretien (LinkedIn ↗)</a><button class="cta" type="button" data-profile>Découvrir le profil global</button></div></div></section>)}
        <section class="panel profile" id="profile" role="tabpanel" aria-labelledby="tab-profile" hidden><div class="heading"><span>08 / SYNTHÈSE</span><h2>De l'ingénierie technique à la stratégie immobilière : une vision transversale</h2></div><div class="profile-grid"><p>Diplômée d'un Master en Génie Civil de La Rochelle Université, j'ai développé une pratique hybride : AMO et conseil immobilier chez ETYO Real Estate, maîtrise d'œuvre et OPC chez Atelier Carré d'Arche, puis des bases solides en ingénierie structurelle à l'ESBAT. Cette trajectoire me permet de relier le terrain, les plans, les coûts et la décision avec une même exigence de précision.</p><div><label>Logiciels</label><div class="chips">{software.map((item) => <span>{item}</span>)}</div><a class="cta download" href={linkedinUrl} target="_blank" rel="noreferrer">Consulter le profil LinkedIn ↗</a></div></div><div class="footer"><p>Parlons d'une opération qui mérite une lecture à la fois technique et stratégique.</p><div><a class="cta" href={linkedinUrl} target="_blank" rel="noreferrer">Discuter de ces opérations en entretien (LinkedIn ↗)</a><button class="cta" type="button" data-profile>Découvrir le profil global</button></div></div></section>
      </main>
    </div>
    <script is:inline>
      const tabs = [...document.querySelectorAll('[data-tab]')]; const panels = [...document.querySelectorAll('[data-panel], #profile')];
      function activate(id) { tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.tab === id))); panels.forEach((panel) => { panel.hidden = panel.id !== `panel-${id}` && !(id === 'profile' && panel.id === 'profile'); }); document.querySelector(id === 'profile' ? '#profile' : `#panel-${id}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
      tabs.forEach((tab) => tab.addEventListener('click', () => activate(tab.dataset.tab))); document.querySelectorAll('[data-profile]').forEach((button) => button.addEventListener('click', () => activate('profile'))); document.querySelector('.brand')?.addEventListener('click', (event) => { event.preventDefault(); activate('profile'); });
    </script>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; } :global(html) { scroll-behavior: smooth; } :global(body) { margin: 0; background: #F2EFE9; color: #1C1C1C; font-family: Georgia, 'Times New Roman', serif; } button, a { font: inherit; } .portfolio { min-height: 100vh; background: radial-gradient(circle at 90% 0, #E8ECE8, transparent 28rem), #F2EFE9; } .header { position: sticky; top: 0; z-index: 2; display: flex; gap: 2rem; align-items: center; padding: 1.2rem clamp(1rem, 4vw, 4rem); border-bottom: 1px solid #D3CDC3; background: rgba(242,239,233,.95); backdrop-filter: blur(16px); } .brand { flex: 0 0 auto; color: #1C1C1C; font: 800 .7rem/1.5 Arial,sans-serif; letter-spacing: .11em; text-decoration: none; text-transform: uppercase; } .brand span { display: block; color: #18453B; font-size: .58rem; letter-spacing: .18em; } .nav { display: flex; flex: 1; gap: .15rem; min-width: 0; overflow-x: auto; scrollbar-width: none; } .nav::-webkit-scrollbar { display: none; } .tab { position: relative; flex: 0 0 auto; border: 0; padding: .75rem .68rem; color: #6D716C; background: transparent; cursor: pointer; font: 700 .66rem Arial,sans-serif; letter-spacing: .08em; } .tab::after { position: absolute; right: .68rem; bottom: .35rem; left: .68rem; height: 3px; background: #18453B; content: ''; transform: scaleX(0); transform-origin: left; transition: transform .28s cubic-bezier(.23,1,.32,1); } .tab:hover, .tab[aria-selected=true] { color: #18453B; background: #E8ECE8; } .tab[aria-selected=true] { font-weight: 900; } .tab[aria-selected=true]::after { transform: scaleX(1); } .external { text-decoration: none; } .main { width: min(100%, 80rem); margin: auto; padding: clamp(3rem, 8vw, 7rem) clamp(1rem, 5vw, 5rem) 4rem; } .hero { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(2rem, 7vw, 7rem); align-items: end; padding-bottom: clamp(3rem, 7vw, 6rem); border-bottom: 1px solid #D3CDC3; } .eyebrow, label, .heading > span { color: #18453B; font: 800 .68rem Arial,sans-serif; letter-spacing: .15em; text-transform: uppercase; } h1 { max-width: 12ch; margin: 1rem 0 1.2rem; font-size: clamp(3.2rem, 8vw, 7.4rem); font-weight: 400; letter-spacing: -.055em; line-height: .88; } h1 em { color: #18453B; font-style: normal; } .intro { max-width: 34rem; color: #555954; font-size: clamp(1rem,1.5vw,1.25rem); line-height: 1.55; } .hero aside { border-left: 3px solid #18453B; padding: 1.4rem 0 1.4rem 1.5rem; font-size: 1.15rem; line-height: 1.45; } .hero aside p { margin: 0; } .hero small { display: block; margin-top: 1.4rem; color: #6D716C; font: .68rem/1.6 Arial,sans-serif; letter-spacing: .08em; text-transform: uppercase; } .panel { padding-top: clamp(3rem, 7vw, 6rem); animation: enter .45s cubic-bezier(.23,1,.32,1); } .panel[hidden] { display: none; } @keyframes enter { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } } .heading { display: grid; grid-template-columns: 4rem 1fr; gap: 1.25rem; } .heading > span { color: #D3CDC3; } h2 { max-width: 18ch; margin: 0; font-size: clamp(2.5rem,6vw,6rem); font-weight: 400; letter-spacing: -.05em; line-height: .9; } .quote, .note, .grid, .footer, .profile-grid { margin-left: 5.25rem; } .quote { max-width: 52rem; margin-top: 2.4rem; font-size: clamp(1.35rem,2.5vw,2.2rem); line-height: 1.2; } .note { border: 1px solid #D3CDC3; padding: 1.1rem 1.25rem; color: #5b5f5a; font: .76rem/1.6 Arial,sans-serif; } .grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; margin-top: 3rem; background: #D3CDC3; } .cell { min-height: 12rem; padding: 1.35rem; background: #F2EFE9; } .wide { grid-column: span 2; } .cell p, .cell ul { margin: .9rem 0 0; color: #4d514c; font: .85rem/1.65 Arial,sans-serif; } .cell ul { padding-left: 1.1rem; } .metrics { display: grid; gap: .6rem; margin-top: .9rem; } .metrics strong { color: #18453B; font-size: 1.22rem; line-height: 1.05; } .value { color: #18453B !important; font: 1.2rem/1.25 Georgia,serif !important; } .footer { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: space-between; align-items: center; margin-top: 3.5rem; padding: 1.2rem; background: #18453B; color: #FBFAF7; } .footer p { max-width: 28rem; margin: 0; font: .75rem/1.45 Arial,sans-serif; } .footer > div { display: flex; flex-wrap: wrap; gap: .55rem; } .cta { border: 1px solid rgba(251,250,247,.4); padding: .75rem .9rem; color: #FBFAF7; background: transparent; cursor: pointer; font: 800 .7rem Arial,sans-serif; letter-spacing: .04em; text-decoration: none; } .cta:hover { color: #18453B; background: #FBFAF7; } .profile-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 3rem; margin-top: 2.5rem; color: #4d514c; font-size: 1.12rem; line-height: 1.6; } .chips { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .9rem; } .chips span { border: 1px solid #D3CDC3; padding: .5rem .65rem; color: #18453B; font: 800 .68rem Arial,sans-serif; } .download { display: inline-block; margin-top: 2rem; color: #18453B; border-color: #18453B; background: #18453B; } @media(max-width:760px) { .header { display: block; padding: 1rem; } .brand { display: block; margin-bottom: .7rem; } .nav { margin: 0 -1rem; padding: 0 1rem; } .hero, .profile-grid { grid-template-columns: 1fr; } .heading { grid-template-columns: 2.5rem 1fr; } .quote, .note, .grid, .footer, .profile-grid { margin-left: 0; } .grid { grid-template-columns: 1fr; } .wide { grid-column: auto; } .footer { flex-direction: column; align-items: stretch; } .footer > div, .cta { text-align: center; } }
</style>

<style>
  .tab { transform: scale(1); transform-origin: center bottom; transition: color .2s ease, background-color .2s ease, transform .28s cubic-bezier(.23,1,.32,1), font-weight .28s ease; }
  .tab:hover, .tab:focus-visible { transform: scale(1.18); color: #18453B; background: #E8ECE8; }
  .tab[aria-selected="true"] { color: #18453B; background: #E8ECE8; font-weight: 900; }
  .tab[aria-selected="true"]::after { transform: scaleX(1); transition: transform .32s cubic-bezier(.23,1,.32,1); }
  .tab:not([aria-selected="true"])::after { transform: scaleX(0); transition: transform .22s cubic-bezier(.23,1,.32,1); }
  .hero { min-height: calc(100svh - 88px); grid-template-columns: minmax(0, .9fr) minmax(24rem, 1.1fr); align-items: center; padding-top: clamp(2rem, 5vw, 4rem); }
  .hero-copy { position: relative; z-index: 1; }
  .hero h1 { color: #293332; font-family: Arial, Helvetica, sans-serif; font-size: clamp(3.5rem, 7vw, 7rem); font-weight: 300; letter-spacing: -.08em; line-height: .9; }
  .hero h1 strong { color: #293332; font-weight: 800; white-space: nowrap; }
  .hero .intro { max-width: 32rem; color: #59615e; font-family: Arial, Helvetica, sans-serif; }
  .hero-cta { display: inline-flex; gap: 1.1rem; align-items: center; margin-top: 1.2rem; border-bottom: 1px solid #18453B; padding: 0 0 .55rem; color: #18453B; font: 800 .7rem Arial, sans-serif; letter-spacing: .1em; text-decoration: none; }
  .hero-cta:hover { transform: translateX(4px); }
  .hero-meta { margin-top: 1.8rem; color: #69716e; font: 800 .64rem Arial, sans-serif; letter-spacing: .12em; }
  .hero-media { position: relative; min-height: min(62vh, 42rem); overflow: hidden; background: #bbb8b0; clip-path: polygon(16% 0, 100% 0, 100% 100%, 0 100%); }
  .hero-media img { width: 100%; height: 100%; min-height: min(62vh, 42rem); object-fit: cover; object-position: center; mix-blend-mode: multiply; opacity: .88; }
  .hero-media-grid { position: absolute; inset: 0; background: linear-gradient(rgba(24,69,59,.14) 1px, transparent 1px), linear-gradient(90deg, rgba(24,69,59,.14) 1px, transparent 1px); background-size: 38px 38px; mix-blend-mode: multiply; opacity: .38; }
  .hero-media-caption { position: absolute; right: 1.3rem; bottom: 1rem; color: #18453B; font: 800 .62rem Arial, sans-serif; letter-spacing: .14em; }
  @media (max-width: 760px) { .hero { min-height: auto; grid-template-columns: 1fr; } .hero-media { min-height: 18rem; clip-path: none; order: -1; } .hero-media img { min-height: 18rem; } .hero h1 { font-size: clamp(3.6rem, 16vw, 6rem); } }
</style>
